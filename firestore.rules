rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function campaignPath(cid) {
      return /databases/$(database)/documents/campaigns/$(cid);
    }
    function memberPath(cid, uid) {
      return /databases/$(database)/documents/campaigns/$(cid)/members/$(uid);
    }
    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }
    function owner(cid) {
      return signed() && exists(campaignPath(cid)) &&
        get(campaignPath(cid)).data.ownerId == request.auth.uid;
    }
    function member(cid) {
      return signed() && exists(memberPath(cid, request.auth.uid)) &&
        get(memberPath(cid, request.auth.uid)).data.status == 'active';
    }
    function validCampaign(data) {
      return data.keys().hasAll(['ownerId','name','ruleset','status','createdAt','updatedAt']) &&
        data.keys().hasOnly(['ownerId','name','ruleset','status','createdAt','updatedAt']) &&
        data.ownerId is string &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.ruleset in ['legacy','dnd'] &&
        data.status in ['active','archived'] &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validMembership(data, uid) {
      return data.keys().hasAll(['userId','role','status','joinedAt','inviteCode','removedAt']) &&
        data.keys().hasOnly(['userId','role','status','joinedAt','inviteCode','removedAt']) &&
        data.userId == uid && data.status == 'active' &&
        data.joinedAt == request.time && data.removedAt == null;
    }
    function invitationValid(code, cid) {
      return code is string && code.matches('^[A-F0-9]{48}$') &&
        exists(invitationPath(code)) &&
        get(invitationPath(code)).data.campaignId == cid &&
        get(invitationPath(code)).data.revoked == false &&
        get(invitationPath(code)).data.expiresAt > request.time &&
        get(campaignPath(cid)).data.status == 'active';
    }
    match /campaigns/{cid} {
      allow create: if signed() && validCampaign(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow get: if owner(cid) || member(cid);
      allow list: if signed() && resource.data.ownerId == request.auth.uid;
      allow update: if owner(cid) && validCampaign(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','updatedAt']) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /members/{uid} {
        allow get: if signed() && (uid == request.auth.uid || owner(cid));
        allow list: if owner(cid);
        allow create: if signed() && uid == request.auth.uid &&
          validMembership(request.resource.data, uid) &&
          (
            (
              getAfter(campaignPath(cid)).data.ownerId == request.auth.uid &&
              request.resource.data.role == 'dm' &&
              request.resource.data.inviteCode == null
            ) ||
            (
              exists(campaignPath(cid)) &&
              get(campaignPath(cid)).data.ownerId != request.auth.uid &&
              request.resource.data.role == 'member' &&
              invitationValid(request.resource.data.inviteCode, cid)
            )
          );
        allow update: if owner(cid) && uid != request.auth.uid &&
          resource.data.role == 'member' && resource.data.status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','removedAt']) &&
          request.resource.data.status == 'removed' &&
          request.resource.data.removedAt == request.time;
        allow delete: if false;
      }
    }
    // Índice personal de membresías, consultable mediante collectionGroup + where(userId==uid).
    match /{path=**}/members/{uid} {
      allow list: if signed() && resource.data.userId == request.auth.uid;
    }
    match /invitations/{code} {
      // Solo quien conoce el código aleatorio puede obtener un documento individual.
      allow get: if signed() && code.matches('^[A-F0-9]{48}$');
      allow list: if signed() && owner(resource.data.campaignId);
      allow create: if signed() && code.matches('^[A-F0-9]{48}$') &&
        request.resource.data.keys().hasAll(['campaignId','createdBy','createdAt','expiresAt','revoked']) &&
        request.resource.data.keys().hasOnly(['campaignId','createdBy','createdAt','expiresAt','revoked']) &&
        request.resource.data.campaignId is string &&
        owner(request.resource.data.campaignId) &&
        get(campaignPath(request.resource.data.campaignId)).data.status == 'active' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.revoked == false &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if owner(resource.data.campaignId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) &&
        resource.data.revoked == false && request.resource.data.revoked == true;
      allow delete: if false;
    }
    // Predeterminado cerrado para perfiles, saves, sesiones y cualquier ruta no aprobada.
    match /{document=**} { allow read, write: if false; }
  }
}
